<Window x:Class="Cove.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cove"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cove"
        Width="1280"
        Height="820"
        MinWidth="880"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#121316"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TabRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Height="28" Padding="8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3138"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#24262C"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24262C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3138"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TabTemplate">
            <Grid Width="168" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>
                <Image Width="14" Height="14" Source="{Binding Favicon}" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="18" Height="18" FontSize="10" Content="&#xE8BB;" Tag="{Binding}" Click="CloseTab_Click" ToolTip="Close tab" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Swatch}" HorizontalAlignment="Left" Tag="{Binding}" MouseLeftButtonUp="CycleColor_Click" ToolTip="Change color"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="18" Height="18" FontSize="10" Content="&#xE8BB;" Tag="{Binding}" Click="DeleteWorkspace_Click" ToolTip="Remove workspace"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinkTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Url}" Foreground="#8D8A84" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryTemplate">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="#8D8A84" FontSize="11" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding Url}" Foreground="#8D8A84" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DownloadTemplate">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="10" Content="&#xE711;" Tag="{Binding}" Click="CancelDownload_Click" ToolTip="Cancel"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar Height="3" Margin="0,6,0,4" Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding Indeterminate}" Foreground="{x:Static local:Theme.Accent}" Background="#2A2D34" BorderThickness="0"/>
                <TextBlock Text="{Binding Detail}" Foreground="#8D8A84" FontSize="11"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MemoryTemplate">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Foreground="#8D8A84" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                    <TextBlock Text="{Binding Kind}" Foreground="#6E6B66" FontSize="10"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border x:Name="SidebarShell" Background="#16181D" BorderBrush="#2A2D34" BorderThickness="0,0,1,0">
            <Grid x:Name="SidebarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Rail">
                    <Button x:Name="BrandButton" Content="C" ToolTip="Drag to the left, right, or bottom. Click to show or hide the panel." Cursor="SizeAll" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Foreground="{x:Static local:Theme.Accent}" Style="{StaticResource RailButton}" Height="40" PreviewMouseLeftButtonDown="Brand_MouseDown" PreviewMouseMove="Brand_MouseMove" PreviewMouseLeftButtonUp="Brand_MouseUp"/>
                    <Button x:Name="RailWorkspaces" Content="&#xE8FD;" Style="{StaticResource RailButton}" ToolTip="Workspaces" Click="Rail_Click" Tag="workspaces"/>
                    <Button x:Name="RailBookmarks" Content="&#xE734;" Style="{StaticResource RailButton}" ToolTip="Bookmarks" Click="Rail_Click" Tag="bookmarks"/>
                    <Button x:Name="RailHistory" Content="&#xE81C;" Style="{StaticResource RailButton}" ToolTip="History" Click="Rail_Click" Tag="history"/>
                    <Button x:Name="RailDownloads" Content="&#xE896;" Style="{StaticResource RailButton}" ToolTip="Downloads" Click="Rail_Click" Tag="downloads"/>
                    <Button x:Name="RailPasswords" Content="&#xE72E;" Style="{StaticResource RailButton}" ToolTip="Passwords" Click="Passwords_Click"/>
                    <Button x:Name="RailExtensions" Content="&#xE7B8;" Style="{StaticResource RailButton}" ToolTip="Extensions" Click="Rail_Click" Tag="extensions"/>
                    <Button x:Name="RailLimiter" Content="&#xE9D9;" Style="{StaticResource RailButton}" ToolTip="Memory" Click="Rail_Click" Tag="limiter"/>
                </StackPanel>

                <Grid x:Name="PanelHost" Grid.Column="1" Margin="0,4,6,6">
                    <Grid x:Name="PanelWorkspaces">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Workspaces" VerticalAlignment="Center" Margin="4,0" FontSize="13" FontWeight="SemiBold"/>
                        <ListBox x:Name="WorkspaceList" Grid.Row="1" ItemContainerStyle="{StaticResource SideRow}" ItemTemplate="{StaticResource WorkspaceTemplate}" SelectionChanged="WorkspaceList_SelectionChanged" MouseDoubleClick="WorkspaceList_MouseDoubleClick"/>
                        <Button Grid.Row="2" Content="Add" Margin="2,6,2,0" Padding="8,5" Click="AddWorkspace_Click"/>
                    </Grid>

                    <Grid x:Name="PanelBookmarks" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Bookmarks" VerticalAlignment="Center" Margin="4,0" FontSize="13" FontWeight="SemiBold"/>
                        <ListBox x:Name="BookmarkList" Grid.Row="1" ItemContainerStyle="{StaticResource SideRow}" ItemTemplate="{StaticResource LinkTemplate}" MouseLeftButtonUp="Bookmark_Open"/>
                        <Button Grid.Row="2" Content="Bookmark" Margin="2,6,2,0" Padding="8,5" Click="Bookmark_Click"/>
                    </Grid>

                    <Grid x:Name="PanelHistory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="History" VerticalAlignment="Center" Margin="4,0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="HistorySearch" Grid.Row="1" Margin="4,0,4,8" Padding="8,6" TextChanged="HistorySearch_TextChanged"/>
                        <ListBox x:Name="HistoryList" Grid.Row="2" ItemContainerStyle="{StaticResource SideRow}" ItemTemplate="{StaticResource HistoryTemplate}" MouseLeftButtonUp="History_Open"/>
                        <Button Grid.Row="3" Content="Clear" Margin="2,6,2,0" Padding="8,5" Click="ClearHistory_Click"/>
                    </Grid>

                    <Grid x:Name="PanelDownloads" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Downloads" VerticalAlignment="Center" Margin="4,0" FontSize="13" FontWeight="SemiBold"/>
                        <ListBox x:Name="DownloadList" Grid.Row="1" ItemContainerStyle="{StaticResource SideRow}" ItemTemplate="{StaticResource DownloadTemplate}" MouseLeftButtonUp="Download_Open"/>
                    </Grid>

                    <Grid x:Name="PanelExtensions" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Extensions" VerticalAlignment="Center" Margin="4,0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Margin="4,0,4,8" Foreground="#8D8A84" FontSize="11" TextWrapping="Wrap" Text="Load an unpacked folder that contains manifest.json. The Chrome Web Store is not connected, and some extensions need APIs this runtime does not have."/>
                        <Button Grid.Row="2" Content="Load unpacked extension" Margin="2,0,2,8" Padding="8,5" Click="LoadExtension_Click"/>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ExtensionHost" Margin="4,0,4,8"/>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="PanelLimiter" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,8,4,0">
                            <TextBlock Text="Memory" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RamLabel" Margin="0,8,0,6" Foreground="#8D8A84" TextWrapping="Wrap"/>
                            <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged"/>
                            <TextBlock Margin="0,4,0,8" Foreground="#8D8A84" FontSize="11" TextWrapping="Wrap" Text="Background tabs sleep when Cove passes this cap. A tab playing audio stays awake."/>
                        </StackPanel>
                        <ListBox x:Name="MemoryList" Grid.Row="1" ItemContainerStyle="{StaticResource SideRow}" ItemTemplate="{StaticResource MemoryTemplate}" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Width="5" HorizontalAlignment="Stretch" Background="#2A2D34" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="SidebarSplitter_DragCompleted"/>

        <Grid x:Name="Browser">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TabRowDef" Height="40"/>
                <RowDefinition x:Name="AddressRowDef" Height="40"/>
                <RowDefinition x:Name="ProgressRowDef" Height="2"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <Grid x:Name="TabChrome" Grid.Row="0" Background="#121316" MouseLeftButtonDown="Drag_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" Background="Transparent" MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ListBox x:Name="TabList" HorizontalAlignment="Left" VerticalAlignment="Center" ItemContainerStyle="{StaticResource TabRow}" ItemTemplate="{StaticResource TabTemplate}" SelectionChanged="TabList_SelectionChanged" PreviewMouseDown="TabList_PreviewMouseDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button x:Name="NewTabButton" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE921;" Click="Min_Click"/>
                <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE922;" Click="Max_Click"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE8BB;" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="AddressChrome" Grid.Row="1" Background="#181A1F" MouseLeftButtonDown="Drag_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Click="Back_Click"/>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward" Click="Forward_Click"/>
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="4,6" Background="#0E0F12" BorderBrush="#2A2D34" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"/>
                    <Button x:Name="StarButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="Bookmark this page" Click="Bookmark_Click"/>
                </Grid>
            </Border>
            <Border x:Name="PrivateBadge" Grid.Column="2" Visibility="Collapsed" Margin="0,0,4,0" VerticalAlignment="Center" Background="#2A2440" CornerRadius="8" Padding="8,3">
                <TextBlock Text="Private" Foreground="#C4B5FD" FontSize="11"/>
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock x:Name="StatusNote" VerticalAlignment="Center" Foreground="#8D8A84" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ShieldButton" Height="28" MinWidth="28" Padding="8,0" Margin="0,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2A2D34" ToolTip="Click to allow this site. Right-click to pause blocking everywhere." Click="Shield_Click" PreviewMouseRightButtonUp="Shield_RightClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShieldCount" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="2" Height="2" BorderThickness="0" Background="Transparent" Foreground="{x:Static local:Theme.Accent}" IsIndeterminate="True" Visibility="Collapsed"/>

        <Border x:Name="SaveBar" Grid.Row="3" Background="#241814" Visibility="Collapsed" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Not now" Margin="0,0,8,0" Click="SaveNotNow_Click"/>
                    <Button Content="Never" Margin="0,0,8,0" Click="SaveNever_Click"/>
                    <Button Content="Save" Click="SavePassword_Click"/>
                </StackPanel>
                <TextBlock x:Name="SaveText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WebHost" Grid.Row="4">
            <StackPanel x:Name="BootPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="BootText" Text="Starting Cove…" Foreground="#8D8A84"/>
                <Button x:Name="BootButton" Content="Install WebView2 runtime" Margin="0,12,0,0" Visibility="Collapsed" Click="BootButton_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
